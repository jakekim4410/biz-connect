generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  name              String
  role              String   // "BUYER", "SELLER", "ADMIN"
  companyName       String
  jobTitle          String   
  phone             String   
  
  userType          String?  
  userTypeDetail    String?  
  preferredPartners String?  

  timeSlots         TimeSlot[]
  meetingsAsBuyer   Meeting[] @relation("BuyerMeetings")
  meetingsAsSeller  Meeting[] @relation("SellerMeetings")
  createdAt         DateTime @default(now())
}

model TimeSlot {
  id          Int      @id @default(autoincrement())
  startTime   DateTime
  endTime     DateTime
  description String?  
  location    String?  // <-- 추가: 최초 생성 시 장소
  status      String   @default("OPEN")
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId     Int
  meetings    Meeting[]
}

model Meeting {
  id                    Int      @id @default(autoincrement())
  status                String   @default("PENDING")
  proposal              String?  
  rejectionReason       String?  
  location              String?  // 최종 확정 장소
  pendingLocation       String?  // <-- 추가: 바이어가 수정을 요청한 임시 장소
  locationChangeStatus  String?  // <-- 추가: "PENDING", "REJECTED" (수락 시 null로 초기화)
  timeSlot              TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  timeSlotId            Int
  buyer                 User     @relation("BuyerMeetings", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId               Int
  seller                User     @relation("SellerMeetings", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId              Int
  createdAt             DateTime @default(now())
}