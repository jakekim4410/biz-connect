generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  name              String
  role              String   // "BUYER", "SELLER", "ADMIN" (전체 관리자)
  companyName       String
  businessNumber    String?  // [추가됨] 사업자등록번호 (SELLER는 필수, BUYER는 선택)
  jobTitle          String   
  phone             String  
  rejectionReason String? 
  
  // [수정] 마스터/멤버 구분 및 승인 시스템
  isMaster          Boolean  @default(false)      // 마스터 여부 (최초 가입자 등)
  approvalStatus    String   @default("APPROVED") // "PENDING", "APPROVED", "REJECTED"

  userType          String?  
  userTypeDetail    String?  
  preferredPartners String?  

  timeSlots         TimeSlot[]
  meetingsAsBuyer   Meeting[] @relation("BuyerMeetings")
  meetingsAsSeller  Meeting[] @relation("SellerMeetings")
  
  onePager          OnePager?

  createdAt         DateTime @default(now())
}

model TimeSlot {
  id          Int      @id @default(autoincrement())
  startTime   DateTime
  endTime     DateTime
  description String?  
  location    String?  
  status      String   @default("OPEN")
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId     Int
  meetings    Meeting[]
}

model Meeting {
  id                    Int      @id @default(autoincrement())
  status                String   @default("PENDING")
  proposal              String?  
  rejectionReason       String?  
  location              String?  
  pendingLocation       String?  
  locationChangeStatus  String?  
  timeSlot              TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  timeSlotId            Int
  buyer                 User     @relation("BuyerMeetings", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId               Int
  seller                User     @relation("SellerMeetings", fields:[sellerId], references: [id], onDelete: Cascade)
  sellerId              Int
  createdAt             DateTime @default(now())
}

model OnePager {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyNameKr   String   @default("") 
  companyNameEn   String   @default("") 
  ceoName         String   @default("") 
  picName         String   @default("") 
  picTitle        String   @default("") 
  
  productType     String   @default("")
  solutionSummary String   @db.Text @default("")
  
  problem         String   @db.Text @default("")
  solution        String   @db.Text @default("")
  traction        String   @db.Text @default("")
  bizModel        String   @db.Text @default("")

  primaryTech     String   @default("")
  industrySector  String   @default("")
  yearFounded     String   @default("")
  investmentStage String   @default("")
  monthlyRevenue  String   @default("")
  pitchDeckUrl    String   @default("")
  contactEmail    String   @default("")

  updatedAt       DateTime @updatedAt
}